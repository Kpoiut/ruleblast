{
  "context": {
    "cwd": "repository-root",
    "trigger": "READ_TARGET",
    "repositoryOnly": true
  },
  "discover": {
    "origins": [
      {
        "kind": "fixed",
        "paths": [".github/copilot-instructions.md"],
        "scopeAnchor": ".github"
      },
      {
        "kind": "fixed",
        "paths": [".claude/CLAUDE.md"],
        "scopeAnchor": ".claude"
      },
      {
        "kind": "glob",
        "pattern": ".github/instructions/**/*.instructions.md",
        "scopeAnchor": ".github",
        "apply": {
          "kind": "frontmatter-glob",
          "field": "applyTo",
          "ifAbsent": "exclude"
        }
      },
      {
        "kind": "ancestors",
        "from": "repositoryRoot",
        "to": "dirname-target",
        "inclusive": true,
        "names": ["AGENTS.md", "CLAUDE.md", "GEMINI.md"]
      }
    ],
    "claimIds": ["copilot.repo.1", "copilot.apply.1", "copilot.agent.1"]
  },
  "select": {
    "mode": "all",
    "names": ["AGENTS.md", "CLAUDE.md", "GEMINI.md"],
    "shadows": {},
    "claimIds": ["copilot.agent.1"]
  },
  "transform": [],
  "assemble": {
    "mode": "unspecified",
    "claimIds": ["copilot.agent.1"]
  },
  "fingerprint": "copilot-v1",
  "onSymlink": "unknown-unfollowed",
  "onAtReference": "partial-unexpanded"
}
