{
  "context": {
    "cwd": "repository-root",
    "trigger": "READ_TARGET",
    "repositoryOnly": true
  },
  "discover": {
    "origins": [
      {
        "kind": "fixed",
        "paths": [".claude/CLAUDE.md", ".claude/settings.json"],
        "scopeAnchor": ".claude"
      },
      {
        "kind": "glob",
        "pattern": "**/.claude/rules/**/*.md",
        "apply": {
          "kind": "frontmatter-glob",
          "field": "paths",
          "ifAbsent": "include",
          "onMatch": "APPLIED_RULE",
          "matcher": "brace-budget"
        }
      },
      {
        "kind": "ancestors",
        "from": "repositoryRoot",
        "to": "dirname-target",
        "inclusive": true,
        "names": ["CLAUDE.md", "CLAUDE.local.md"]
      }
    ],
    "claimIds": ["claude.memory.1", "claude.ancestors.1", "claude.rules.1", "claude.nested-rules.1"]
  },
  "select": {
    "mode": "all",
    "names": ["CLAUDE.md", "CLAUDE.local.md"],
    "shadows": {},
    "claimIds": ["claude.memory.1"],
    "onSameBasename": "partial-no-payload"
  },
  "transform": [
    {
      "kind": "strip-html-comments",
      "claimIds": ["claude.comments.1"]
    },
    {
      "kind": "at-path-import",
      "maxDepth": 4,
      "lexer": "markdown-v1",
      "claimIds": ["claude.imports.1"]
    },
    {
      "kind": "json-exclude-globs",
      "path": ".claude/settings.json",
      "field": "claudeMdExcludes",
      "claimIds": ["claude.excludes.1"]
    }
  ],
  "assemble": {
    "mode": "unspecified",
    "claimIds": ["claude.globs.1"]
  },
  "fingerprint": "claude-v1",
  "onSymlink": "unknown-unfollowed"
}
